    "better-auth": "^1.6.28",
    "drizzle-orm": "0.45.2",
    "langchain": "^1.5.8",
    "mammoth": "^1.12.1",
    "next": "^16.3.1",
    "pg": "^8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "read-excel-file": "^9.3.10",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
